# Full origin of the backend API this frontend talks to.
# Only set VITE_API_URL in .env.production (used by `npm run build`) —
# e.g. https://kspvib-backend.onrender.com — so deployed builds hit the main
# server. Leave it unset in .env/.env.development: `npm run dev` then uses the
# Vite proxy (vite.config.js) to forward /api to the LOCAL server on :3000,
# which avoids CORS entirely.
VITE_API_URL=https://kspvib-backend.onrender.com
