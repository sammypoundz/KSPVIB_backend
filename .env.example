# Origin(s) of the frontend that may call this API, comma-separated.
# Example for hosting frontend and backend on different servers:
# ALLOWED_ORIGINS=https://your-frontend.example.com,https://kspvib.netlify.app
# Leave unset to allow all origins (prototype only — lock down for production).
ALLOWED_ORIGINS=https://kiirs.org.ng,https://kspvib.kiirs.org.ng

# Public URL of this backend, used to build absolute PDF/QR links:
# PUBLIC_BASE_URL=https://your-backend.example.com
PUBLIC_BASE_URL=https://kspvib-backend.onrender.com
# Public URL of the FRONTEND that hosts the /verify page — the
# "Scan to verify" link/QR code on invoices & receipts points here.
# NOTE: You MUST set FRONTEND_URL in Render's Environment settings for the
# backend service, otherwise the QR falls back to the backend URL above.
FRONTEND_URL=https://kiirs.org.ng
